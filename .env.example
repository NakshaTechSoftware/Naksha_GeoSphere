########################################################################
# Naksha GeoSphere — Environment Configuration Template
#
# Copy this file to `.env` for local development:
#   cp .env.example .env          (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# The bootstrap scripts (scripts/bootstrap.ps1 / scripts/bootstrap.sh) do
# this automatically and generate random local secrets for you.
#
# NEVER commit a real `.env` file. Values below are non-sensitive
# placeholders / local-only development defaults.
########################################################################

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="Naksha GeoSphere"
APP_ENV=development
# development | testing | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
API_URL=http://api:8000
PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Comma-separated list of trusted hostnames (TrustedHostMiddleware)
TRUSTED_HOSTS=localhost,127.0.0.1,api

# Enable/disable interactive OpenAPI docs (/docs, /redoc)
API_DOCS_ENABLED=true

# ------------------------------------------------------------------
# PostgreSQL / PostGIS
# ------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=naksha_geosphere
POSTGRES_USER=naksha_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_SECRET

# Full async SQLAlchemy connection string (must match values above)
DATABASE_URL=postgresql+asyncpg://naksha_app:REPLACE_WITH_LOCAL_DEV_SECRET@postgres:5432/naksha_geosphere

# ------------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------
# Object Storage (MinIO locally / S3-compatible in production)
# ------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY

S3_REGION=us-east-1
S3_BUCKET_SOURCE_DATA=geosphere-source-data
S3_BUCKET_PREVIEW_DATA=geosphere-preview-data
S3_BUCKET_ORDER_OUTPUT=geosphere-order-output
S3_BUCKET_TEMPORARY_DATA=geosphere-temporary-data

# Seconds a pre-signed download URL remains valid
SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------
# Mail (local testing via Mailpit)
# ------------------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@nakshageosphere.local

# SMTP used by the worker to actually send mail (e.g. account
# verification emails). Points at Mailpit in local development — no
# authentication needed there, so SMTP_USERNAME/SMTP_PASSWORD stay
# blank. Set these to a real provider's values in staging/production;
# never commit real values.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nakshageosphere.local
SMTP_USE_TLS=false

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
# Generated automatically by scripts/bootstrap.ps1 / bootstrap.sh
# Used for signing internal tokens. Rotate per environment.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# ------------------------------------------------------------------
# Authentication / registration
# ------------------------------------------------------------------
# How long an email-verification link stays valid.
EMAIL_VERIFICATION_EXPIRY_MINUTES=30

# Policy versions stamped onto each user at signup (terms_accepted_at
# always records when, these record which version they accepted).
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Registration rate limits, enforced via Redis.
REGISTRATION_RATE_LIMIT_PER_IP=5
REGISTRATION_RATE_LIMIT_PER_IP_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT_PER_EMAIL=3
REGISTRATION_RATE_LIMIT_PER_EMAIL_WINDOW_SECONDS=3600

# ------------------------------------------------------------------
# Host port mapping (development only — override if a port is busy)
# ------------------------------------------------------------------
WEB_HOST_PORT=3000
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# ------------------------------------------------------------------
# Frontend build-time
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Naksha GeoSphere"

# ------------------------------------------------------------------
# External environment/weather APIs
# ------------------------------------------------------------------
# Personal API key for the data.gov.in CPCB real-time AQI resource
# (https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69).
# Backend-only — never sent to the frontend. Leave blank to run without
# official CPCB data; Open-Meteo weather/air-quality still work.
DATA_GOV_IN_API_KEY=
