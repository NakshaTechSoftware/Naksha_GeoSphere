# Windows folder containing ECW files. UNC/network paths are supported by the
# Windows host worker. Example: S:\ECW or \\nas\NAKSHA\Imagery
ECW_SOURCE_ROOT=S:\path\to\ecw-folder

# Optional: restrict scan to a specific date or subdirectory pattern (e.g., "28-11-2023")
# Leave empty to scan all subdirectories. Useful for 200+ GB datasets to process
# only the date range you need.
ECW_SCAN_PATTERN=

# Number of parallel ECW→COG conversion threads (default: 4)
SCAN_MAX_WORKERS=4

# Used when an ECW reports RAW/LOCAL and no usable .prj/CRS is available.
DEFAULT_SOURCE_CRS=EPSG:32643

# Backend / frontend
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database / Redis
POSTGRES_DB=geosphere
POSTGRES_USER=geosphere
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://geosphere:change-this-password@postgres:5432/geosphere
REDIS_URL=redis://redis:6379/0

# Local development email verification. Verification links are written to
# runtime/mailbox instead of being sent by SMTP.
PUBLIC_FRONTEND_URL=http://localhost:3000
DEV_RETURN_VERIFICATION_TOKEN=true

# Catalog and raster behavior
AUTO_SCAN_ON_STARTUP=true
CATALOG_SYNC_SECONDS=5
TILE_CACHE_SECONDS=86400
MAX_EXPORT_DATASETS=250
MAX_EXPORT_AREA_SQ_KM=5000
COG_JPEG_QUALITY=90
