########################################################################
# Naksha GeoSphere — Remote Storage Mode additional variables.
#
# Only needed when running against a separate storage-server machine on
# the LAN (see infrastructure/storage-server/) instead of local
# PostgreSQL/Redis/MinIO containers.
#
# HOW TO USE:
#   Merge these lines into your root .env (append them, or copy the
#   values in) — Compose only auto-loads a single .env file, so this is
#   not used standalone. Do NOT also define POSTGRES_HOST_PORT /
#   REDIS_HOST_PORT / MINIO_*_HOST_PORT local-storage values at the same
#   time as running in remote-storage mode; they are unused in that mode.
#
# Every value below (host, ports, credentials, bucket names) MUST
# exactly match what was configured in the storage-server's own
# .env.storage — see infrastructure/storage-server/.env.storage.example.
#
# Never commit a real .env with these values filled in.
########################################################################

# LAN IP of the storage-server machine.
STORAGE_SERVER_IP=192.168.10.81

# --- PostgreSQL (on the storage server) ------------------------------
DATABASE_HOST=192.168.10.81
DATABASE_PORT=5544
POSTGRES_DB=naksha_geosphere
POSTGRES_USER=geosphere_app
POSTGRES_PASSWORD=REPLACE_WITH_STORAGE_SERVER_POSTGRES_PASSWORD

# --- Redis (on the storage server) ------------------------------------
REDIS_HOST=192.168.10.81
REDIS_PORT=6390
REDIS_PASSWORD=REPLACE_WITH_STORAGE_SERVER_REDIS_PASSWORD

# --- S3-compatible object storage (on the storage server) -------------
S3_API_HOST_PORT=9010
S3_ENDPOINT_URL=http://192.168.10.81:9010
S3_FORCE_PATH_STYLE=true
S3_SECURE=false
S3_ACCESS_KEY=REPLACE_WITH_STORAGE_SERVER_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STORAGE_SERVER_S3_SECRET_KEY
S3_REGION=geosphere

S3_SOURCE_BUCKET=geosphere-source-data
S3_PREVIEW_BUCKET=geosphere-preview-data
S3_ORDER_BUCKET=geosphere-order-output
S3_TEMPORARY_BUCKET=geosphere-temporary-data
