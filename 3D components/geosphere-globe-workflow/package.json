{
  "name": "geosphere-globe-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated cinematic looping prototype of the Naksha GeoSphere customer journey: globe -> India -> Karnataka -> local area -> AOI -> geospatial data -> export -> payment -> secure delivery. Not wired into the main application.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "stress": "vitest run src/tests/stress.test.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "gsap": "^3.12.7",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "world-atlas": "^2.0.2"
  }
}
