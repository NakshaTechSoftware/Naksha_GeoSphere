# Geosphere Workflow Prototype — environment configuration
#
# This prototype never hard-codes a paid map provider. If these values are
# left unset, the prototype falls back to the free MapLibre demo style
# (see src/map/mapFallback.ts) which is suitable for DEVELOPMENT
# DEMONSTRATION ONLY, not production or commercial use.

# Full MapLibre style JSON URL (e.g. a self-hosted style, MapTiler, Stadia,
# or any style your organization is licensed to use).
VITE_MAP_STYLE_URL=

# Optional access token appended by mapConfig.ts when the style URL requires
# one (e.g. ?key=... providers). Never commit a real token.
VITE_MAP_ACCESS_TOKEN=
