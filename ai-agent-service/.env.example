[TEMPLATE]
########################################################################
# Naksha GeoAI Agent Service — environment template.
# Copy to .env and fill in real values. Never commit a real .env.
########################################################################

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="Naksha GeoAI Agent Service"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,ai-agent-service

# ------------------------------------------------------------------
# LLM Provider — 'openai', 'ollama', or 'opencode'
# ------------------------------------------------------------------
LLM_PROVIDER=openai

# OpenAI (cloud)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=          # Override for Azure or OpenAI-compatible APIs
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# Ollama (local LLM)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Tried qwen2.5:1.5b for speed on CPU-only hardware (this hardware's 4GB
# WDDM GPU is already busy with desktop compositing — Ollama's scheduler
# puts 0 layers on it regardless, confirmed via `ollama ps` -> size_vram:0,
# even with options.num_gpu forced). 1.5b prefills ~2x faster but failed a
# live tool-calling test outright (never emitted a tool call, echoed the
# injected location text back as prose instead of using it) — not an
# acceptable trade for this agent's tool-heavy workload. Stick with 3b
# unless a smaller model is re-validated end-to-end against real queries.
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_MODEL= naksha-geoai-model  # Custom optimized model (build with Modelfile)
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120

# OpenCode Zen (cloud, OpenAI-compatible — MiMo-V2.5-Free)
OPENCODE_API_KEY=your-opencode-api-key-here
OPENCODE_MODEL=mimo-v2.5-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MAX_TOKENS=4096
OPENCODE_TEMPERATURE=0.1
OPENCODE_TIMEOUT=60

# ------------------------------------------------------------------
# GeoAI Tool Adapter Service (internal Docker network)
# ------------------------------------------------------------------
GEOAI_BASE_URL=http://geoai-service:8000
GEOAI_API_KEY=REPLACE_WITH_GENERATED_KEY
GEOAI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------
# Redis (conversation memory)
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/3
MEMORY_TTL_SECONDS=3600
MEMORY_MAX_MESSAGES=50

# ------------------------------------------------------------------
# Security — API key(s) for frontend → agent authentication.
# Comma-separated to support key rotation.
# ------------------------------------------------------------------
AGENT_API_KEYS=REPLACE_WITH_GENERATED_KEY
RATE_LIMIT_PER_KEY=60
RATE_LIMIT_WINDOW_SECONDS=60

# Max LLM tool-calling rounds before forced text answer.
MAX_TOOL_ROUNDS=10

# Enable Server-Sent Events streaming responses.
ENABLE_STREAMING=true

# ------------------------------------------------------------------
# Host port mapping (development only)
# ------------------------------------------------------------------
AGENT_HOST_PORT=8200
OLLAMA_HOST_PORT=11434
