########################################################################
# GeoAI Tool Adapter Service — environment template.
# Copy to .env and fill in real values. Never commit a real .env.
########################################################################

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="GeoAI Tool Adapter Service"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Comma-separated list of allowed CORS origins. This service is called
# server-to-server (by the LLM/agent runtime), so this is normally empty
# or restricted to that runtime's own origin — never the public browser.
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,geoai-service

# ------------------------------------------------------------------
# PostGIS — same Postgres instance the main GeoSphere stack already runs.
# This service only ever creates/reads its own poi_* tables (see
# migrations/) — it never touches naksha-api's application tables.
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://naksha_app:REPLACE_WITH_LOCAL_DEV_SECRET@postgres:5432/naksha_geosphere

# ------------------------------------------------------------------
# Redis — cache for reverse-geocode / nearby / layer-query results.
# Point this at the same Redis the main stack runs, on a separate
# logical DB index so key sweeps never collide with Celery's queues.
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/2
CACHE_TTL_NEARBY_SECONDS=120
CACHE_TTL_GEOCODE_SECONDS=900
CACHE_TTL_LAYER_QUERY_SECONDS=300

# ------------------------------------------------------------------
# MinIO — internal, server-side only. Never returned to the caller and
# never passed to the LLM. Used only as a fallback data source for
# nearby/layer queries when no PostGIS table exists for that layer yet.
# ------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_SECRET_KEY
MINIO_SOURCE_BUCKET=geosphere-source-data

# ------------------------------------------------------------------
# Existing GeoSphere backends this service wraps. Internal Docker
# hostnames only — never exposed to the LLM or the caller.
# ------------------------------------------------------------------
# Next.js BFF — owns /api/geocode, /api/routing, /api/land-records/*,
# /api/datasets/*
GEOSPHERE_WEB_BASE_URL=http://web:3000
# FastAPI backend — owns /api/v1/environment/*, /api/v1/pricing/*
GEOSPHERE_API_BASE_URL=http://api:8000
UPSTREAM_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------
# Security — API key(s) the LLM/agent runtime authenticates with.
# Comma-separated to support rotation (add the new key, redeploy the
# agent runtime, then remove the old key).
# ------------------------------------------------------------------
GEOAI_API_KEYS=REPLACE_WITH_GENERATED_KEY

# Requests allowed per API key per window (Redis fixed-window).
RATE_LIMIT_PER_KEY=60
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------
# Host port mapping (development only)
# ------------------------------------------------------------------
GEOAI_HOST_PORT=8100
