            "type": "string",
            "enum": [
              "driving",
              "walking",
              "cycling"
            ],
            "title": "Mode",
            "default": "driving"
          }
        },
        "type": "object",
        "required": [
          "origin",
          "destination"
        ],
        "title": "RouteRequest"
      },
      "RouteResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status",
            "default": "success"
          },
          "distance_meters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Meters"
          },
          "duration_seconds": {
