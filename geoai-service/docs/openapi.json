            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LandRecordRequest": {
        "properties": {
          "district": {
            "type": "string",
            "title": "District"
          },
          "taluk": {
            "type": "string",
            "title": "Taluk"
          },
          "hobli": {
            "type": "string",
            "title": "Hobli"
          },
          "village": {
            "type": "string",
            "title": "Village"
          },
          "survey": {
            "type": "string",
            "title": "Survey"
          },
          "surnoc": {
            "type": "string",
            "title": "Surnoc",
            "default": "*"
          },
          "hissa": {
            "type": "string",
            "title": "Hissa",
            "default": "*"
          }
        },
        "type": "object",
        "required": [
          "district",
          "taluk",
          "hobli",
          "village",
          "survey"
        ],
        "title": "LandRecordRequest"
      },
      "LandRecordResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status",
            "default": "success"
          },
          "owners": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Owners"
          },
          "use_case": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use Case"
          }
        },
        "type": "object",
        "title": "LandRecordResponse"
      },
      "LatLon": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon"
      },
      "NearbyRequest": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "police_station",
              "hospital",
              "school",
              "atm",
              "pharmacy"
            ],
            "title": "Type"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "radius": {
            "type": "integer",
            "maximum": 50000.0,
            "exclusiveMinimum": 0.0,
            "title": "Radius",
            "description": "Search radius in meters.",
            "default": 2000
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "exclusiveMinimum": 0.0,
            "title": "Limit",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "type",
          "lat",
          "lon"
        ],
        "title": "NearbyRequest"
      },
      "NearbyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status",
            "default": "success"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/NearbyResultItem"
            },
            "type": "array",
            "title": "Results"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "NearbyResponse"
      },
      "NearbyResultItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "police_station",
              "hospital",
              "school",
              "atm",
              "pharmacy"
            ],
            "title": "Type"
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters"
          },
          "location": {
            "$ref": "#/components/schemas/LatLon"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "source": {
            "type": "string",
            "enum": [
              "postgis",
              "minio_geojson"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "distance_meters",
          "location",
          "source"
        ],
        "title": "NearbyResultItem"
      },
      "PlaceResult": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "label",
          "lat",
          "lon"
        ],
        "title": "PlaceResult"
      },
      "ReverseGeocodeRequest": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "ReverseGeocodeRequest"
      },
      "ReverseGeocodeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status",
            "default": "success"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "place_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Name"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          }
        },
        "type": "object",
        "title": "ReverseGeocodeResponse"
      },
      "RouteRequest": {
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/LatLon"
          },
          "destination": {
            "$ref": "#/components/schemas/LatLon"
