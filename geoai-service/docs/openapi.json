{
  "openapi": "3.1.0",
  "info": {
    "title": "GeoAI Tool Adapter Service",
    "description": "Controlled, typed tool surface between an AI agent and the GeoSphere platform's PostGIS database, MinIO object storage, and internal APIs. The agent never receives credentials or internal URLs \u2014 every call here is validated, rate-limited, cached, and logged.",
    "version": "1.0.0"
  },
