            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "layer"
        ],
        "title": "DatasetLayerRequest"
      },
      "DatasetLayerResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status",
            "default": "success"
          },
          "feature_collection": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Collection"
          }
        },
        "type": "object",
        "title": "DatasetLayerResponse"
      },
      "EnvironmentSnapshotRequest": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
