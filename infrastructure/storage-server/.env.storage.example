########################################################################
# Naksha GeoSphere — Storage Server environment template.
#
# Copy to .env.storage on the storage-server machine and fill in real,
# strong, randomly generated values for every blank field.
#
#   Copy-Item .env.storage.example .env.storage
#
# NEVER commit a real .env.storage file. It is git-ignored.
#
# These same credential/host/port values must be mirrored into the main
# application's .env (via .env.remote-storage.example at the repo root)
# when the main app is run in remote-storage mode.
########################################################################

# LAN IP this machine's Docker services bind to. Must match an IP
# actually assigned to this host's network interface.
STORAGE_SERVER_IP=192.168.10.81

# --- PostgreSQL / PostGIS ---------------------------------------------
POSTGRES_HOST_PORT=5544
POSTGRES_DB=naksha_geosphere
POSTGRES_USER=geosphere_app
POSTGRES_PASSWORD=

# --- Redis --------------------------------------------------------------
REDIS_HOST_PORT=6390
REDIS_PASSWORD=

# --- S3-compatible object storage (MinIO) ------------------------------
S3_API_HOST_PORT=9010
S3_CONSOLE_HOST_PORT=9011
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=geosphere

S3_SOURCE_BUCKET=geosphere-source-data
S3_PREVIEW_BUCKET=geosphere-preview-data
S3_ORDER_BUCKET=geosphere-order-output
S3_TEMPORARY_BUCKET=geosphere-temporary-data
